{
  "name": "resume-platform",
  "private": true,
  "version": "1.0.0",
  "description": "毛际可个人技术展示平台 — qiankun + monorepo",
  "scripts": {
    "dev:all": "./start.sh",
    "dev": "pnpm --parallel -r run dev",
    "dev:portal": "pnpm --filter portal dev",
    "dev:resume": "pnpm --filter @resume/resume dev",
    "dev:admin": "pnpm --filter @resume/admin dev",
    "build": "pnpm -r run build",
    "build:portal": "pnpm --filter portal build",
    "build:resume": "pnpm --filter @resume/resume build",
    "build:admin": "pnpm --filter @resume/admin build",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "dev:city": "pnpm --filter @resume/digital-city dev",
    "build:city": "pnpm --filter @resume/digital-city build",
    "dev:dashboard": "pnpm --filter @resume/dashboard dev",
    "build:dashboard": "pnpm --filter @resume/dashboard build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
